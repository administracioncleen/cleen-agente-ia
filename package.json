{
  "name": "cleen-agente-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de IA para atender WhatsApp, Messenger e Instagram de Cleen (purificadores de aire)",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "shopify:token": "tsx src/shopify/getTokenServer.ts",
    "test:chat": "tsx src/testChat.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
