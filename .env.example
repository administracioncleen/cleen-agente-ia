# --- Anthropic (motor de IA) ---
ANTHROPIC_API_KEY=

# --- Meta (WhatsApp Cloud API / Messenger / Instagram Messaging) ---
# Token de verificacion que tu elijes al configurar el webhook en Meta for Developers
META_WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta, para validar la firma de cada webhook (X-Hub-Signature-256)
META_APP_SECRET=
# Token de acceso permanente (System User token) con permisos whatsapp_business_messaging,
# pages_messaging, instagram_manage_messages
META_ACCESS_TOKEN=
# ID del numero de telefono de WhatsApp Business (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=
# ID de la Pagina de Facebook vinculada a Instagram/Messenger
META_PAGE_ID=

# --- Shopify (catalogo y stock en vivo) ---
SHOPIFY_STORE_DOMAIN=cleen-cl.myshopify.com
# Admin API access token final (lo obtienes corriendo "npm run shopify:token", ver README)
SHOPIFY_ADMIN_ACCESS_TOKEN=
# URL publica de la tienda, para armar los links de producto que manda el bot
SHOPIFY_PUBLIC_STORE_URL=https://cleen.cl
# Nombre exacto de la sucursal (Shopify > Configuracion > Ubicaciones) cuyo stock usa el bot.
# El bot NO suma el stock de otras sucursales. Dejar vacio usa "Sucursal Shippit".
SHOPIFY_LOCATION_NAME=Sucursal Shippit

# --- Shopify: solo para obtener el token una vez (npm run shopify:token) ---
# ID de cliente / Secreto del cliente de la pestana "Credenciales" de tu app en Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# --- Base de datos ---
DATABASE_URL=postgres://user:password@host:5432/cleen_agente

# --- Escalamiento a humano ---
# Numero de WhatsApp (formato E.164, ej. 56912345678) o webhook de Slack/email que recibe el aviso
ESCALATION_NOTIFY_WHATSAPP_NUMBER=

PORT=3000
